# Basic newsboat configuration

# Reload all feeds every 30 minutes
reload-time 30
auto-reload yes

# Show a notification-style summary of reload
reload-threads 1

# Browser used to open articles
browser "xdg-open %u"

# Display
show-read-feeds no
max-items 100

# Keybindings (sensible defaults, kept explicit)
bind-key j down
bind-key k up
bind-key j next articlelist
bind-key k prev articlelist
bind-key h prev articlelist
bind-key l next articlelist
bind-key o open
bind-key q quit
